# ---------- Core ----------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# PostgreSQL connection. If unset, a local SQLite file is used (dev only).
DATABASE_URL=postgres://pareena:pareena@localhost:5432/pareena

# Frontend origin(s) allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Public URL of the React site, used in emails
FRONTEND_URL=http://localhost:5173
# Public URL of this API, used for admin links in emails
BACKEND_URL=http://localhost:8000

# ---------- Media storage ----------
# local | s3 | cloudinary
STORAGE_BACKEND=local
# S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
# Cloudinary (single URL form: cloudinary://<key>:<secret>@<cloud_name>)
CLOUDINARY_URL=

# ---------- Email ----------
# Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pareena Eye Care Center <no-reply@pareenaeyecare.com>
# Where new-booking / new-consultation alerts go (comma separated)
DOCTOR_NOTIFICATION_EMAILS=doctor@example.com

# ---------- Phone / WhatsApp ----------
DEFAULT_COUNTRY_CODE=91

# ---------- Razorpay (online payments) ----------
# Leave empty to disable online payment (pay-at-store still works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay Dashboard → Webhooks → secret (URL: <BACKEND_URL>/api/v1/payments/razorpay/webhook/)
RAZORPAY_WEBHOOK_SECRET=
# Minutes after which unpaid online orders are cancelled by `release_unpaid_orders`
UNPAID_ORDER_TIMEOUT_MINUTES=30
CURRENCY=INR

# ---------- Google Meet generation (optional) ----------
# OAuth client + refresh token of the doctor's Google account with Calendar access.
# See docs/GOOGLE_MEET_SETUP.md. If unset, the doctor pastes a Meet link manually in admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------- Google reviews (optional) ----------
# Places API (New) key and the store's Place ID. Without them the site links to Google instead.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---------- Rate limits ----------
CONSULTATION_RATE=5/hour
APPOINTMENT_RATE=10/hour
ORDER_RATE=20/hour
PRESCRIPTION_RATE=30/hour
